{%- comment -%}
  Single-product launch hero: auto-rotating 3D model in front of a giant colour word,
  buy box right on the homepage, sticky buy bar once the hero scrolls away.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p = s.product | default: collections.all.products.first
  assign current = p.selected_or_first_available_variant
  assign model = p.media | where: 'media_type', 'model' | first
-%}
<section class="launch" style="--glow: {{ s.glow }}" data-launch>
  <p class="launch__word" aria-hidden="true">
    {%- assign letters = s.word | split: '' -%}
    {%- for l in letters -%}<span style="--i:{{ forloop.index0 }}">{{ l }}</span>{%- endfor -%}
  </p>

  <div class="launch__stage" data-launch-stage>
    {%- if model -%}
      {{ model | model_viewer_tag: image_size: '1400x', auto-rotate: true, auto-rotate-delay: 0, rotation-per-second: '22deg', interaction-prompt: 'none', camera-orbit: '0deg 78deg 105%', shadow-intensity: '1.2', shadow-softness: '0.9', exposure: '1.1', class: 'launch__model', alt: p.title }}
    {%- elsif p.featured_image -%}
      {{ p.featured_image | image_url: width: 1600 | image_tag: class: 'launch__img', alt: p.title, loading: 'eager' }}
    {%- endif -%}
  </div>

  <div class="launch__info">
    <p class="launch__eyebrow">{{ s.eyebrow }}</p>
    <h1 class="launch__title">{{ s.heading | default: p.title }}</h1>
    <p class="launch__price">{% render 'price', price: current.price, compare: current.compare_at_price %}</p>
    {%- form 'product', p, class: 'launch__form', id: 'launch-form', data-add-form: '' -%}
      <input type="hidden" name="id" value="{{ current.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="btn btn--dark btn--lg btn--atc launch__btn"{% unless current.available %} disabled{% endunless %}>
        {%- render 'icon', name: 'bag' -%}
        <span>{%- if current.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}</span>
      </button>
    {%- endform -%}
    <a href="{{ p.url }}" class="launch__more">Discover every detail</a>
  </div>

  <div class="launch__side">
    {%- if s.edition != blank -%}<p class="launch__edition">{{ s.edition }}</p>{%- endif -%}
    <ul class="launch__usps">
      <li>Full-grain Italian leather</li>
      <li>Complimentary shipping</li>
      <li>Arrives in its dust bag</li>
    </ul>
  </div>
  <span class="launch__cue" aria-hidden="true"><span></span></span>
</section>

<div class="launch-bar" data-launch-bar aria-hidden="true">
  <span class="launch-bar__img">{{ p.featured_image | image_url: width: 120 | image_tag: alt: '', loading: 'lazy' }}</span>
  <span class="launch-bar__name">{{ s.heading | default: p.title }}<small>{{ current.price | money }}</small></span>
  <button type="submit" form="launch-form" class="btn btn--dark launch-bar__btn"{% unless current.available %} disabled{% endunless %}>{{ 'products.add_to_cart' | t }}</button>
</div>

{% schema %}
{
  "name": "Launch hero (1 product)",
  "class": "section-launch",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Upload a .glb under the product's Media to show the rotating 3D model." },
    { "type": "text", "id": "word", "label": "Giant word behind the product", "default": "GIALLO" },
    { "type": "color", "id": "glow", "label": "Glow colour", "default": "#e3b73a" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The new Traveller" },
    { "type": "text", "id": "heading", "label": "Title (empty = product title)" },
    { "type": "text", "id": "edition", "label": "Edition note", "default": "Edizione limitata. Made in small numbers, never restocked." }
  ],
  "presets": [{ "name": "Launch hero (1 product)" }]
}
{% endschema %}
