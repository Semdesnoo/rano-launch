{%- comment -%} Cinematic story: full-width film, title centred, the steps as columns along the bottom. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="story-film" id="{{ s.anchor }}">
  <div class="story-film__media">
    {% render 'video', video: s.video, video_asset: s.video_asset, poster: s.poster, class: 'cover' %}
  </div>
  <div class="story-film__inner">
    <div class="story-film__head reveal">
      {%- if s.eyebrow != blank -%}<p class="story-film__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="story-film__title">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="story-film__text">{{ s.text }}</p>{%- endif -%}
      {%- if s.button_label != blank -%}<a href="{{ s.button_link | default: '/pages/about-us' }}" class="story-film__link">{{ s.button_label }}</a>{%- endif -%}
    </div>
    <ol class="story-film__steps">
      {%- for block in section.blocks -%}
        <li class="story-film__step reveal" style="--d: {{ forloop.index0 | times: 120 }}ms" {{ block.shopify_attributes }}>
          <span class="story-film__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }} · {{ block.settings.italian }}</span>
          <h3 class="story-film__step-title">{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Story film",
  "class": "section-story-film",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "story" },
    { "type": "video", "id": "video", "label": "Video (upload)" },
    { "type": "text", "id": "video_asset", "label": "Bundled video file", "default": "atelier.mp4" },
    { "type": "text", "id": "poster", "label": "Bundled poster image", "default": "atelier.jpg" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "La nostra storia" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The story behind Rano" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Read our story" },
    { "type": "url", "id": "button_link", "label": "Link" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "italian", "label": "Italian label", "default": "La scelta" },
      { "type": "text", "id": "title", "label": "Title", "default": "Selecting the leather" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ]}
  ],
  "presets": [{ "name": "Story film" }]
}
{% endschema %}
