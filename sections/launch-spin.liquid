{%- comment -%} 3D product on white: model turns on its own on a soft plinth, specs left and right. Upload a .glb as product media. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p = s.product | default: collections.all.products.first
  assign model = p.media | where: 'media_type', 'model' | first
-%}
<section class="section spin3d" style="--glow: {{ s.glow }}">
  <div class="container spin3d__inner">
    <header class="spin3d__head reveal">
      <p class="spin3d__kicker">{{ s.kicker }}</p>
      <h2 class="spin3d__heading">{{ s.heading | default: p.title }}</h2>
    </header>
    <div class="spin3d__grid">
      <ul class="spin3d__specs spin3d__specs--left">
        {%- for i in (1..2) -%}{%- assign k = 'spec_' | append: i -%}{%- assign v = 'value_' | append: i -%}
          {%- if s[k] != blank -%}<li class="reveal"><span>{{ s[k] }}</span><b>{{ s[v] }}</b></li>{%- endif -%}
        {%- endfor -%}
      </ul>
      <div class="spin3d__stage">
        <span class="spin3d__plinth" aria-hidden="true"></span>
        {%- if model -%}
          {{ model | model_viewer_tag: image_size: '1400x', auto-rotate: true, auto-rotate-delay: 0, rotation-per-second: '16deg', interaction-prompt: 'none', camera-orbit: '0deg 78deg 105%', shadow-intensity: '1', shadow-softness: '1', exposure: '1.05', class: 'spin3d__model', alt: p.title }}
        {%- else -%}
          {{ p.featured_image | image_url: width: 1400 | image_tag: class: 'spin3d__img', alt: p.title, loading: 'lazy' }}
        {%- endif -%}
        <span class="spin3d__badge" aria-hidden="true">360°</span>
      </div>
      <ul class="spin3d__specs spin3d__specs--right">
        {%- for i in (3..4) -%}{%- assign k = 'spec_' | append: i -%}{%- assign v = 'value_' | append: i -%}
          {%- if s[k] != blank -%}<li class="reveal"><span>{{ s[k] }}</span><b>{{ s[v] }}</b></li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
    <div class="spin3d__foot reveal">
      <span class="spin3d__price">{{ p.price | money }}</span>
      <a href="{{ p.url }}" class="btn btn--dark spin3d__btn">{{ s.button_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "3D product",
  "class": "section-spin3d",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Upload a .glb under the product's Media." },
    { "type": "color", "id": "glow", "label": "Soft glow colour", "default": "#e3b73a" },
    { "type": "text", "id": "kicker", "label": "Small label", "default": "In ogni dettaglio" },
    { "type": "text", "id": "heading", "label": "Heading (empty = product title)", "default": "Every angle, considered" },
    { "type": "text", "id": "spec_1", "label": "Detail 1 label", "default": "Leather" },
    { "type": "text", "id": "value_1", "label": "Detail 1", "default": "Full-grain, Italian" },
    { "type": "text", "id": "spec_2", "label": "Detail 2 label", "default": "Hardware" },
    { "type": "text", "id": "value_2", "label": "Detail 2", "default": "Silver-tone" },
    { "type": "text", "id": "spec_3", "label": "Detail 3 label", "default": "Size" },
    { "type": "text", "id": "value_3", "label": "Detail 3", "default": "Cabin-friendly" },
    { "type": "text", "id": "spec_4", "label": "Detail 4 label", "default": "Origin" },
    { "type": "text", "id": "value_4", "label": "Detail 4", "default": "Casarano, Italia" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Discover the Traveller" }
  ],
  "presets": [{ "name": "3D product" }]
}
{% endschema %}
