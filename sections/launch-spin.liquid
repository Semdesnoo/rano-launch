{%- comment -%} Simple 3D section: the product model turns on its own. Upload a .glb as product media. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p = s.product | default: collections.all.products.first
  assign model = p.media | where: 'media_type', 'model' | first
-%}
<section class="section spin3d" style="--glow: {{ s.glow }}">
  <div class="container spin3d__inner">
    <p class="spin3d__kicker reveal">{{ s.kicker }}</p>
    <h2 class="h2 spin3d__heading reveal">{{ s.heading }}</h2>
    <div class="spin3d__stage">
      {%- if model -%}
        {{ model | model_viewer_tag: image_size: '1400x', auto-rotate: true, auto-rotate-delay: 0, rotation-per-second: '18deg', interaction-prompt: 'none', camera-orbit: '0deg 78deg 105%', shadow-intensity: '1.2', exposure: '1.1', class: 'spin3d__model', alt: p.title }}
      {%- else -%}
        {{ p.featured_image | image_url: width: 1400 | image_tag: class: 'spin3d__img', alt: p.title, loading: 'lazy' }}
      {%- endif -%}
    </div>
    {%- if s.note != blank -%}<p class="spin3d__note">{{ s.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "3D product",
  "class": "section-spin3d",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Upload a .glb under the product's Media." },
    { "type": "color", "id": "glow", "label": "Glow colour", "default": "#e3b73a" },
    { "type": "text", "id": "kicker", "label": "Small label", "default": "Every angle, considered" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Giallo Traveller" },
    { "type": "text", "id": "note", "label": "Small text under the model", "default": "Full-grain leather · Silver-tone hardware · Made in Italy" }
  ],
  "presets": [{ "name": "3D product" }]
}
{% endschema %}
