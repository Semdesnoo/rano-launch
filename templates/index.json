        "eyebrow": "La nostra storia",
        "heading": "The story behind Rano"
      },
      "blocks": {
        "s0": {
          "type": "step",
          "settings": {
            "italian": "La scelta",
            "title": "Selecting the leather",
            "text": "Every hide is chosen by hand for its grain, weight and the way it softens. Only full-grain leather makes the cut."
          }
        },
        "s1": {
          "type": "step",
          "settings": {
            "italian": "Il taglio",
            "title": "Cut by hand",
            "text": "Patterns are laid out to follow the natural grain, then cut with a blade, piece by piece, so every panel lines up."
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "italian": "La cucitura",
            "title": "Stitched to last",
            "text": "Dense, even stitching and reinforced handle joints. A travel bag has to carry more than looks."
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "italian": "La rifinitura",
            "title": "Finished with intention",
            "text": "Edges are smoothed and sealed, hardware checked, the Rano mark pressed in. Then it waits for its first journey."
          }
        }
      },
