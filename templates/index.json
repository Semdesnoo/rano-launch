          "settings": {
            "italian": "Il pellame",
            "title": "Full-grain leather",
            "text": "Chosen hide by hide for its grain and weight. It softens with every trip and takes on your story.",
            "orbit": "-18 80 105"
          }
        },
        "c1": {
          "type": "chapter",
          "settings": {
            "italian": "La forma",
            "title": "A shape that holds",
            "text": "Structured enough to stand on its own, soft enough to slide into an overhead cabin.",
            "orbit": "22 64 96"
          }
        },
        "c2": {
          "type": "chapter",
          "settings": {
            "italian": "I dettagli",
            "title": "Hardware you can feel",
            "text": "Silver-tone buckles, a smooth two-way zip and a pressed Rano tag. Quiet details, built to last.",
            "orbit": "180 74 102"
          }
        },
        "c3": {
          "type": "chapter",
          "settings": {
            "italian": "Il viaggio",
            "title": "Made for the journey",
            "text": "A detachable, adjustable strap and handles reinforced at every joint. From a weekend in Puglia to a late flight home.",
            "orbit": "0 88 114"
          }
        }
      },
